# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is listed in .gitignore.

# Supabase — both values are public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server only, NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Gemini (AI Studio) — server only, NEVER expose to the client
#
# Multi-key pool: supply multiple keys to distribute traffic across them.
# The pool uses round-robin (LRU) selection and automatically puts a key on
# cooldown when it hits a 429, rotating to the next available key.
#
# Option A — comma-separated list (recommended):
# GEMINI_API_KEYS=AIza..key1,AIza..key2,AIza..key3
#
# Option B — numbered keys (useful in some hosting environments):
# GEMINI_API_KEY_1=AIza..key1
# GEMINI_API_KEY_2=AIza..key2
#
# Option C — single key (original, still works):
# GEMINI_API_KEY=AIza..key1
#
# All three formats are checked in order and de-duplicated.
# At least one key must be present or the server will fail on the first
# Gemini call with a clear error.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional pool tuning (defaults shown):
# GEMINI_DEFAULT_COOLDOWN_MS=60000   # how long to cool down a key after 429
# GEMINI_BASE_BACKOFF_MS=500         # initial inter-attempt backoff
# GEMINI_MAX_BACKOFF_MS=8000         # backoff cap
# GEMINI_MAX_ATTEMPTS=0              # 0 = auto: min(keys*2, 16)
