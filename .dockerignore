# Dependencies — reinstalled inside the image
node_modules

# Build output — produced inside the image
.next
out

# Secrets — must NEVER be baked into the image
.env
.env.*
.env.local
.env.production

# Git history
.git
.gitignore

# Dev/CI files not needed in the image
tests
scripts
migrations
*.test.ts

# ai-instruction/ is mostly dev docs, but ai-instruction/ai-gen/ holds the
# analysis system prompt read at RUNTIME — exclude only the dev-only parts and
# keep ai-gen/ in the build context so it ships in the image (fixes ENOENT on
# /app/ai-instruction/ai-gen/generate-meeting.md).
ai-instruction/features
ai-instruction/tracking.md
ai-instruction/ui-design_default.md
ai-instruction/ui-design_luxury.md
ai-instruction/ui-design_playfull.md

# Editor / OS noise
.DS_Store
*.log
npm-debug.log*
.vscode
.idea
